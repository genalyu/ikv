+class Scorer:
+    def __init__(self, prefer_old=False): self.prefer_old=prefer_old; self.calls=[]
+    def score(self,candidates,task,query_time,subtask="",memory=""):
+        self.calls.append((subtask,memory))
+        return {c.uid: (-c.time if self.prefer_old else c.time) for c in candidates}
