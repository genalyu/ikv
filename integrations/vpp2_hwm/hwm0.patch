+"""Episode-scoped HWM IKV. Scorer and native Planner encoders stay separate.
+
+incremental_reuse archives current-head KV, not a reconstruction of temporal
+history-pack KV. Native history capacity/masks are retained; representation and
+context freshness deliberately differ from window_refresh.
+"""
+from collections import OrderedDict
+from dataclasses import dataclass
+import hashlib
+import math
+
+import numpy as np
+import torch
+
+from .denoising import axis_rope, joint_mask, rotate, video_rope
+
+
+@dataclass(frozen=True)
+class IKVOptions:
+    backend: str = "learned"
+    max_prototypes: int = 4096
+    history_mode: str = "off"
+    planner_mode: str = "lower_only"
+    source_root: str = ""
+    checkpoint: str = ""
+    encoder_path: str = ""
+    device: str = "cuda:0"
+    max_bytes: int = 64 * 1024**3
+    max_frames: int = 2048
+
+    @classmethod
+    def parse(cls, value):
+        value = {} if value is None else value
+        if not isinstance(value, dict):
+            raise ValueError("ikv must be a mapping")
+        unknown = set(value) - set(cls.__dataclass_fields__)
+        if unknown:
+            raise ValueError(f"Unknown IKV options: {sorted(unknown)}")
+        value = dict(value)
+        if value.get("history_mode") == "incremental":
+            value["history_mode"] = "incremental_reuse"
+        options = cls(**value)
+        if options.backend not in {"learned", "formula"}:
+            raise ValueError("Unknown IKV backend")
+        if options.backend == "formula" and options.planner_mode == "interactive":
+            raise ValueError("Formula has no Planner-feedback term; use lower_only")
+        if options.history_mode not in {"off", "window_refresh", "incremental_reuse"}:
+            raise ValueError("Invalid IKV history_mode")
+        if options.planner_mode not in {"lower_only", "interactive"}:
+            raise ValueError("Invalid IKV planner_mode")
+        if options.history_mode == "off" and options.planner_mode != "lower_only":
+            raise ValueError("interactive requires an enabled IKV history_mode")
+        if type(options.max_bytes) is not int or options.max_bytes <= 0:
+            raise ValueError("max_bytes must be positive")
+        if type(options.max_frames) is not int or options.max_frames < 21:
+            raise ValueError("max_frames must be at least 21")
+        return options
+
+
+def native_history_budget(history_count, cfg):
+    """Count the actual native packing layout without running the VAE."""
+    if history_count == 0:
+        return 0
+    length = history_count // cfg.temporal_stride + 1
+    gh, gw = cfg.head_grid
+    kernels = cfg.m["history_kernels"]
+    ph, pw = cfg.m["patch_size"][1:]
+    def size(n, kernel):
+        kt, kh, kw = kernel
+        return math.ceil(n / kt) * math.ceil(gh / (kh // ph)) * math.ceil(gw / (kw // pw))
+    total = size(1, kernels[0]) * (2 if length > 1 else 1)
+    near = max(1, length - 1 - cfg.history["near_latents"])
+    if length > 2:
+        total += size(length - 1 - near, kernels[1])
+    if near > 1:
+        total += size(near - 1, kernels[2])
+    return total
+
+
+class HWMRequest:
+    """One selection plan, before the first attention, shared by every layer."""
+    def __init__(self, episode, step, history_offsets, mode, subtask, memory):
+        self.episode = episode
+        self.cfg = episode.cfg
+        self.step = step
+        self.offsets = history_offsets
+        self.mode = mode
+        self.subtask, self.memory = subtask, memory
+        self.budget = native_history_budget(len(history_offsets), self.cfg)
+        self.tx = None
+        self.fresh = []
+        self.positions = {}
+        self.selected_freqs = None
+        self.valid_mask = None
+        self.layers_seen = set()
+
+    def _head_candidates(self):
+        from ikv_runtime import Candidate, Region
+        cfg, step = self.cfg, self.step
+        gh, gw = cfg.head_grid
+        frame_id = self.episode.frame_id(step)
+        candidates = []
+        for y in range(gh):
+            for x in range(gw):
+                candidates.append(Candidate(
+                    uid=f"current_head:{frame_id}:{y}:{x}",
+                    time=step / cfg.history["control_clock_hz"],
+                    regions=(Region(frame_id, 0, (y/gh, x/gw, (y+1)/gh, (x+1)/gw)),),
+                    provenance="hwm_current_head_incremental_v1",
+                ))
+        freqs = video_rope(torch.tensor([0.0]), gh, gw, cfg).reshape(-1, cfg.m["head_dim"] // 2)
+        return candidates, freqs
+
+    def _packed_candidates(self, packed):
+        from ikv_runtime import Candidate, Region
+        cfg = self.cfg
+        if packed is None:
+            return [], torch.empty(0, cfg.m["head_dim"] // 2, dtype=torch.complex64)
+        stride = cfg.temporal_stride
+        count = stride * (len(self.offsets) // stride)
+        raw_steps = [self.step + offset for offset in self.offsets] + [self.step]
+        raw_steps = [raw_steps[0], *raw_steps[-count:]] if count else [raw_steps[0]]
+        # Wan uses temporal convolutions: use a conservative causal prefix for
+        # scorer provenance, rather than claiming each latent sees only four RGBs.
+        supports = [raw_steps[:1]] + [raw_steps[:i+1] for i in range(stride, len(raw_steps), stride)]
+        length = len(supports)
+        groups = [(cfg.m["history_kernels"][0], [slice(0, 1)])]
+        if length > 1:
+            groups[0][1].append(slice(length-1, length))
+        near = max(1, length-1-cfg.history["near_latents"])
+        if length > 2:
+            groups.append((cfg.m["history_kernels"][1], [slice(near, length-1)]))
+        if near > 1:
+            groups.append((cfg.m["history_kernels"][2], [slice(1, near)]))
+        gh, gw = cfg.head_grid
+        ph, pw = cfg.m["patch_size"][1:]
+        candidates = []
+        for kernel, spans in groups:
+            kt, kh, kw = kernel
+            sy, sx = kh // ph, kw // pw
+            for span in spans:
+                selected = supports[span]
+                for begin in range(0, len(selected), kt):
+                    frames = sorted(set(s for support in selected[begin:begin+kt] for s in support))
+                    for y in range(0, gh, sy):
+                        for x in range(0, gw, sx):
+                            box = (y/gh, x/gw, min(y+sy, gh)/gh, min(x+sx, gw)/gw)
+                            regions = tuple(Region(self.episode.frame_id(s), 0, box, 1/len(frames)) for s in frames)
+                            signature = repr((frames, tuple(kernel), y, x)).encode()
+                            uid = "packed:" + hashlib.sha256(signature).hexdigest()[:24]
+                            candidates.append(Candidate(uid, max(frames)/cfg.history["control_clock_hz"], regions, "hwm_historypack_v1_causal_support"))
+        if len(candidates) != packed[0].shape[1]:
+            raise RuntimeError("History metadata does not match native packing")
+        return candidates, packed[1][0, :, 0].detach().cpu()
+
+    def prepare(self, cache):
+        if self.mode == "incremental_reuse":
+            self.fresh, frequencies = self._head_candidates()
+        else:
+            self.fresh, frequencies = self._packed_candidates(cache.packed)
+        self.positions = dict(self.episode.positions)
+        self.positions.update({candidate.uid: (frequencies[i], self.step) for i, candidate in enumerate(self.fresh)})
+        def scores(candidates):
+            return self.episode.scorer.score(candidates, task=self.episode.task,
+                query_time=self.step/self.cfg.history["control_clock_hz"],
+                subtask=self.subtask, memory=self.memory)
+        self.tx = self.episode.bank.begin(self.fresh, self.budget, score_fn=scores)
+        selected_freqs = []
+        time_width = self.cfg.rope["video_axes"][0] // 2
+        for uid in self.tx.selected_ids:
+            freq, origin_step = self.positions[uid]
+            freq = freq.clone()
+            shift = (origin_step-self.step) / self.cfg.latent_time_steps
+            freq[:time_width] *= axis_rope(torch.tensor([shift]), self.cfg.rope["video_axes"][0], self.cfg.rope["base"])[0]
+            selected_freqs.append(freq)
+        self.valid_mask = torch.as_tensor(self.tx.valid_mask, dtype=torch.bool, device=cache.mask.device)
+        while len(selected_freqs) < self.budget:
+            selected_freqs.append(torch.ones(self.cfg.m["head_dim"]//2, dtype=torch.complex64))
+        self.selected_freqs = (torch.stack(selected_freqs)[None, :, None].to(cache.mask.device)
+            if selected_freqs else torch.empty(1, 0, 1, self.cfg.m["head_dim"]//2, dtype=torch.complex64, device=cache.mask.device))
+        mask = joint_mask(self.budget, cache.mask.device, self.cfg).clone()
+        mask[..., :self.budget] &= self.valid_mask
+        if self.mode == "incremental_reuse":
+            mask = mask[:, :, self.budget:, :]
+        cache.mask = mask
+        cache.ikv = self
+
+    def layer(self, index, raw_key, raw_value, history_queries):
+        if index in self.layers_seen:
+            raise RuntimeError("IKV layer was populated twice")
+        cfg = self.cfg
+        n = len(self.fresh)
+        start = 0 if self.mode == "window_refresh" else history_queries
+        def extract(value):
+            return value[:, start:start+n].unflatten(-1, (cfg.m["heads"], cfg.m["head_dim"])).transpose(1, 2).contiguous()
+        selected_key, selected_value, valid = self.tx.layer(index, extract(raw_key), extract(raw_value), seq_dim=2)
+        if not torch.equal(torch.as_tensor(valid, device=self.valid_mask.device), self.valid_mask):
+            raise RuntimeError("IKV selection differs across layers")
+        self.layers_seen.add(index)
+        flat = selected_key.transpose(1, 2).flatten(2)
+        return rotate(flat, self.selected_freqs, cfg), selected_value
+
+    def commit(self):
+        self.tx.commit()
+        live = {candidate.uid for candidate in self.episode.bank.candidates}
+        self.episode.positions = {uid: value for uid, value in self.positions.items() if uid in live}
+
+    def abort(self):
+        if self.tx is not None:
+            self.tx.abort()
+
+
+class EpisodeIKV:
+    def __init__(self, key, cfg, options, scorer, task):
+        from ikv_runtime import ArchiveBank
+        self.key, self.cfg, self.options, self.task = key, cfg, options, task
+        self.scorer = scorer
+        self.bank = ArchiveBank(expected_layers=cfg.m["layers"], max_bytes=options.max_bytes)
+        self.positions = {}
+        self.frames = OrderedDict()
+        self.planner_features = OrderedDict()
+        self.last_step = -1
+        self.last_result = None
+        self.last_input_digest = None
+        self.last_input_semantics = None
+
+    def frame_id(self, step):
+        return f"{self.key}:{step}"
+
+    def register(self, step, current, history):
+        cfg = self.cfg
+        for frame, offset in zip(*history, strict=True):
+            self._register_head(step+offset, frame)
+        head = current[:cfg.observation.height]
+        self._register_head(step, head)
+        h, w = cfg.observation.height, cfg.observation.width
+        self.scorer.register_frame(self.frame_id(step), step/cfg.history["control_clock_hz"],
+            {0:head, 1:current[h:, :w//2], 2:current[h:, w//2:]})
+        # KV references retained in the archive must keep their scorer frames.
+        needed = {r.frame_id for c in self.bank.candidates for r in c.regions}
+        needed.update(self.frame_id(step+offset) for offset in history[1])
+        needed.add(self.frame_id(step))
+        while len(self.frames) > self.options.max_frames:
+            victim = next((s for s in self.frames if self.frame_id(s) not in needed), None)
+            if victim is None:
+                raise RuntimeError("IKV RGB retention cap reached by live archive; increase max_frames or reduce max_bytes")
+            del self.frames[victim]
+            self.planner_features.pop((self.frame_id(victim), "head"), None)
+
+    def _register_head(self, step, head):
+        if step in self.frames:
+            if not np.array_equal(self.frames[step], head):
+                raise ValueError("Frame ID reused with different image pixels")
+            return
+        self.scorer.register_frame(self.frame_id(step), step/self.cfg.history["control_clock_hz"], {0:head})
+        self.frames[step] = np.asarray(head).copy()
+
+    def planner_history(self, step, native_history, subtask, memory):
+        if self.options.planner_mode == "lower_only":
+            return native_history
+        from ikv_runtime import Candidate, Region
+        frames = [s for s in self.frames if s < step]
+        candidates = [Candidate(f"planner:{self.frame_id(s)}", s/self.cfg.history["control_clock_hz"],
