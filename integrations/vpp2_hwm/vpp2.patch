+"""VPP2 inference-only IKV adapters.
+
+Raw model keys are archived before RoPE. The scorer selects token candidates;
+it never replaces the RGB input with selected frames. Imports are lazy so the
+released baseline requires no IKV dependencies.
+"""
+from __future__ import annotations
+
+import json
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+HISTORY_MODES = ("off", "window_refresh", "incremental_reuse")
+
+
+def validate_history_mode(value):
+    value = str(value)
+    if value == "incremental":
+        value = "incremental_reuse"
+    if value not in HISTORY_MODES:
+        raise ValueError(f"history_mode must be one of {HISTORY_MODES}, got {value!r}")
+    return value
+
+
+def apply_rotary(keys, frequencies, heads, *, inverse=False):
+    """Rotate [batch, sequence, heads * head_dim], without changing values."""
+    shape = keys.shape
+    if len(shape) != 3 or shape[-1] % heads or shape[-1] // heads % 2:
+        raise ValueError("Expected [B,N,H*D] keys with even head dimension")
+    x = keys.to(torch.float64).reshape(shape[0], shape[1], heads, -1, 2)
+    x = torch.view_as_complex(x)
+    freqs = frequencies.to(device=keys.device)
+    if inverse:
+        freqs = freqs.conj()
+    return torch.view_as_real(x * freqs).reshape(shape).to(keys.dtype)
+
+
+def tshape_regions(frame_ids, row, column, height, width):
+    """Map a composed-image patch to weighted original-camera rectangles.
+
+    Original T-shape canvas is 480x880: head 480x640, then two 240x240
+    wrists stacked vertically. Resize to 240x416 preserves these fractions.
+    Regions describe nominal VAE frame groups, not an exact receptive field.
+    """
+    from ikv_runtime import Region
+
+    y0, y1 = row / height, (row + 1) / height
+    x0, x1 = column / width, (column + 1) / width
+    regions = []
+    patch_area = (y1 - y0) * (x1 - x0)
+    cameras = (
+        (0, 0.0, 0.0, 1.0, 8.0 / 11.0),
+        (1, 0.0, 8.0 / 11.0, 0.5, 1.0),
+        (2, 0.5, 8.0 / 11.0, 1.0, 1.0),
+    )
+    for sensor, cy0, cx0, cy1, cx1 in cameras:
+        iy0, ix0, iy1, ix1 = max(y0, cy0), max(x0, cx0), min(y1, cy1), min(x1, cx1)
+        if iy1 <= iy0 or ix1 <= ix0:
+            continue
+        area_weight = (iy1 - iy0) * (ix1 - ix0) / patch_area / len(frame_ids)
+        box = ((iy0 - cy0) / (cy1 - cy0), (ix0 - cx0) / (cx1 - cx0),
+               (iy1 - cy0) / (cy1 - cy0), (ix1 - cx0) / (cx1 - cx0))
+        for frame_id in frame_ids:
+            regions.append(Region(frame_id=str(frame_id), sensor=sensor, box=box,
+                                  weight=area_weight))
+    return tuple(regions)
+
+
+class VPP2IKVRuntime:
+    """One isolated environment; its scorer fork shares frozen model weights."""
+
+    def __init__(self, *, mode, scorer, expected_layers, env_id=0,
+                 max_bytes=64 * 1024**3):
+        from ikv_runtime import ArchiveBank
+
+        self.mode = validate_history_mode(mode)
+        if self.mode == "off":
+            raise ValueError("Do not construct an IKV runtime for baseline mode")
+        self.scorer = scorer
+        self.env_id = int(env_id)
+        self.episode = 0
+        self.bank = ArchiveBank(expected_layers=int(expected_layers), max_bytes=int(max_bytes))
+        self.frames = OrderedDict()
+        self.anchor = None
+        self.anchor_clip = None
+        self.last_diagnostics = None
+        self.last_step = None
+
+    def frame_id(self, step):
+        return f"vpp2/e{self.env_id}/ep{self.episode}/t{int(step):010d}"
+
+    def observe(self, step, images):
+        step = int(step)
+        captured = {int(sensor): np.array(rgb, dtype=np.uint8, copy=True)
+                    for sensor, rgb in images.items()}
+        if set(captured) != {0, 1, 2}:
+            raise ValueError("VPP2 scorer needs head=0, left wrist=1, right wrist=2")
+        if step in self.frames:
+            if any(not np.array_equal(captured[sensor], self.frames[step][sensor])
+                   for sensor in captured):
+                raise ValueError("An observation timestamp cannot change its RGB contents")
+            return
+        if self.last_step is not None and step <= self.last_step:
+            raise ValueError("Observation timestamps must increase within an episode")
+        self.last_step = step
+        self.frames[step] = captured
+        if self.anchor is None:
+            self.anchor = (step, captured)
+        limit = 177 if self.mode == "window_refresh" else 1
+        while len(self.frames) > limit:
+            self.frames.popitem(last=False)
+
+    def request(self, *, task, step, selected_steps=None, anchor_image=None):
+        if self.mode == "window_refresh":
+            if selected_steps is None or len(selected_steps) != 9:
+                raise ValueError("window_refresh needs the native nine-frame source metadata")
+            source_groups = [[selected_steps[0]], selected_steps[1:5], selected_steps[5:9]]
+        else:
+            source_groups = [[int(step)]]
+        for source_step in sorted({int(s) for group in source_groups for s in group}):
+            images = self.frames.get(source_step)
+            if images is None and self.anchor is not None and self.anchor[0] == source_step:
+                images = self.anchor[1]
+            if images is None:
+                raise RuntimeError(f"Missing raw scorer observation at step {source_step}")
+            self.scorer.register_frame(self.frame_id(source_step), source_step / 25.0, images)
+        return VPP2IKVRequest(self, str(task), int(step), source_groups, anchor_image)
+
+    def reset(self):
+        self.bank.reset()
+        self.scorer.reset()
+        self.frames.clear()
+        self.anchor = None
+        self.anchor_clip = None
+        self.last_diagnostics = None
+        self.last_step = None
+        self.episode += 1
+
+
+class VPP2IKVRequest:
+    def __init__(self, runtime, task, step, source_groups, anchor_image):
+        self.runtime = runtime
+        self.mode = runtime.mode
+        self.task = task
+        self.step = step
+        self.source_groups = source_groups
+        self.anchor_image = anchor_image
+        self.tx = None
+        self.pending_clip = None
+        self.prepared = False
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, traceback):
+        if self.tx is not None:
+            if exc_type is None:
+                try:
+                    self.tx.commit()
+                except BaseException:
+                    self.tx.abort()
+                    raise
+                if self.pending_clip is not None:
+                    self.runtime.anchor_clip = self.pending_clip
+                self.runtime.last_diagnostics = {
+                    "mode": self.mode, "step": self.step, "budget": self.budget,
+                    "fresh_tokens": self.fresh_count,
+                    "selected_ids": list(self.tx.selected_ids),
+                    "valid_tokens": int(self.tx.valid_mask.sum().item()),
+                    "query_tokens": self.query_count,
+                    "cache_tokens": self.cache_count,
+                }
+            else:
+                self.tx.abort()
+        elif exc_type is None:
+            raise RuntimeError("IKV request exited without running the KV adapter")
+        return False
+
+    def get_anchor_clip(self, model):
+        cached = self.runtime.anchor_clip
+        if cached is None:
+            if self.anchor_image is None:
+                raise ValueError("incremental_reuse needs the episode anchor for initial CLIP encoding")
+            cached = model._encode_clip_fea_from_image(self.anchor_image)
+            self.pending_clip = cached.detach().cpu()
+        return cached.to(device=model.device, dtype=model.torch_dtype)
+
+    def condition_latents(self, encoded):
+        if self.mode != "incremental_reuse":
+            if encoded.shape[2] != 3:
+                raise ValueError("window_refresh expects the native three condition latents")
+            return encoded
+        if encoded.shape[2] != 1:
+            raise ValueError("incremental_reuse must encode exactly the current RGB frame")
+        # Current belongs to native slot 2; slots 0/1 are never transformer queries.
+        result = encoded.new_zeros(encoded.shape[:2] + (3,) + encoded.shape[3:])
+        result[:, :, 2:3] = encoded
+        return result
+
+    def prepare(self, video_pre, attention_mask, *, heads):
+        from ikv_runtime import Candidate
+
+        if self.prepared:
+            raise RuntimeError("An IKV transaction can prefill only once")
+        frames, height, width = video_pre["meta"]["grid_size"]
+        if frames != 5 or video_pre["tokens"].shape[0] != 1:
+            raise ValueError("VPP2 IKV requires batch1 and the native five-latent video layout")
+        self.heads = int(heads)
+        self.tokens_per_frame = height * width
+        self.budget = 3 * self.tokens_per_frame
+        self.cache_count = 5 * self.tokens_per_frame
+        self.fresh_count = len(self.source_groups) * self.tokens_per_frame
+        self.target_freqs = video_pre["freqs"][:self.budget]
+        candidates = []
+        for group_index, group in enumerate(self.source_groups):
+            source_slot = group_index if self.mode == "window_refresh" else 2
+            frame_ids = [self.runtime.frame_id(s) for s in group]
+            group_key = ",".join(str(int(s)) for s in group)
+            for row in range(height):
+                for column in range(width):
+                    uid = (f"vpp2/e{self.runtime.env_id}/ep{self.runtime.episode}/"
+                           f"{self.mode}/slot{source_slot}/g{group_key}/r{row:04d}/c{column:04d}")
+                    candidates.append(Candidate(
+                        uid=uid, time=max(group) / 25.0,
+                        regions=tshape_regions(frame_ids, row, column, height, width),
+                        provenance=json.dumps({"mode": self.mode, "source_steps": group,
+                                               "source_slot": source_slot,
+                                               "grid": [height, width],
+                                               "mapping": "nominal_vae_time_group"},
+                                              sort_keys=True)))
+        self.fresh_ids = tuple(candidate.uid for candidate in candidates)
+        self.tx = self.runtime.bank.begin(
+            candidates, budget=self.budget,
+            score_fn=lambda all_candidates: self.runtime.scorer.score(
+                all_candidates, self.task, query_time=self.step / 25.0))
+        # The current query is always in native temporal slot 2. During
+        # warmup, align real memory to the end of the condition prefix so a
+        # lone current frame keeps that same phase instead of moving to slot 0.
+        # This changes padding placement only; it protects no candidate IDs.
+        self.padding_left = (self.budget - len(self.tx.selected_ids)
+                             if self.mode == "incremental_reuse" else 0)
+        self.model_valid_mask = (torch.arange(self.budget) >= self.padding_left
+                                 if self.mode == "incremental_reuse"
+                                 else self.tx.valid_mask.clone())
+        valid = self.model_valid_mask.to(device=attention_mask.device)
+        action_mask = attention_mask.clone()
+        action_mask[:, :self.budget] &= valid[None, :]
+        prepared = dict(video_pre)
+        if self.mode == "incremental_reuse":
+            start = 2 * self.tokens_per_frame
+            prepared["tokens"] = video_pre["tokens"][:, start:]
+            prepared["freqs"] = video_pre["freqs"][start:]
+            prepared["context_mask"] = video_pre["context_mask"][:, start:]
+            video_mask = action_mask[start:self.cache_count, :self.cache_count]
+        else:
+            video_mask = attention_mask[:self.cache_count, :self.cache_count]
+        self.query_count = prepared["tokens"].shape[1]
+        self.prepared = True
+        return prepared, video_mask, action_mask
+
+    def layer(self, layer_idx, keys, values, *, raw_keys=None):
+        if not self.prepared:
+            raise RuntimeError("prepare must run before a KV layer")
+        if raw_keys is None or raw_keys.shape != keys.shape:
+            raise ValueError("IKV requires the model's actual normalized pre-RoPE keys")
+        fresh_v = values[:, :self.fresh_count]
+        selected_k, selected_v, _valid = self.tx.layer(
+            int(layer_idx), raw_keys[:, :self.fresh_count], fresh_v, seq_dim=1)
+        if self.padding_left:
+            # ArchiveBank returns a valid prefix plus right padding. Repack
+            # only this model's consumer view before assigning destination RoPE.
+            count = len(self.tx.selected_ids)
+            selected_k = torch.cat((torch.zeros_like(selected_k[:, :self.padding_left]),
+                                    selected_k[:, :count]), dim=1)
+            selected_v = torch.cat((torch.zeros_like(selected_v[:, :self.padding_left]),
+                                    selected_v[:, :count]), dim=1)
+        if self.mode == "window_refresh" and self.tx.selected_ids == self.fresh_ids:
+            # Preserve bitwise native inference when the plan selects the entire
+            # fresh window in place; avoid an unnecessary BF16 RoPE round trip.
+            cache_k, cache_v = keys, values
+        else:
+            relocated_k = apply_rotary(selected_k, self.target_freqs, self.heads)
+            cache_k = torch.cat((relocated_k, keys[:, self.fresh_count:]), dim=1)
+            cache_v = torch.cat((selected_v, values[:, self.fresh_count:]), dim=1)
+        if cache_k.shape[1] != self.cache_count:
+            raise RuntimeError("IKV changed the native action-visible cache capacity")
+        if self.mode == "incremental_reuse":
+            return cache_k, cache_v, cache_k, cache_v
+        return keys, values, cache_k, cache_v
+
