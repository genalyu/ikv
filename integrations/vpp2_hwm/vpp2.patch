+import unittest
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+from torch import nn
+
+from vpp2.ikv import VPP2IKVRuntime, apply_rotary, tshape_regions
+from vpp2.models.wan21_14b.mot import MoT
+from vpp2.models.wan21_14b.wan_video_dit import DiTBlock
+
+
+class FakeScorer:
+    def __init__(self):
+        self.frames = {}
+        self.calls = 0
+
+    def register_frame(self, frame_id, timestamp, images):
+        self.frames[frame_id] = (timestamp, images)
+
+    def score(self, candidates, task, query_time, subtask="", memory=""):
+        self.calls += 1
+        # Explicit test fixture: prefer old memories even when current is fresh.
+        return {candidate.uid: -candidate.time for candidate in candidates}
+
+    def reset(self):
+        self.frames.clear()
+
+    def fork(self):
+        return FakeScorer()
+
+
+class TinyExpert(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.num_heads = 2
+        self.attn_head_dim = 4
+        self.use_video_tokens = False
+        self.use_gradient_checkpointing = False
+        self.blocks = nn.ModuleList([
+            DiTBlock(hidden_dim=8, attn_head_dim=4, num_heads=2, ffn_dim=16)
+            for _ in range(2)
+        ])
+
+
+def make_pre(seed=0, height=2, width=3):
+    generator = torch.Generator().manual_seed(seed)
+    count = 5 * height * width
+    phase = torch.arange(count, dtype=torch.float64)[:, None, None]
+    phase = phase * torch.tensor([0.13, 0.31], dtype=torch.float64)[None, None, :]
+    freqs = torch.polar(torch.ones_like(phase), phase)
+    return {
+        "tokens": torch.randn((1, count, 8), generator=generator),
+        "freqs": freqs,
+        "t_mod": torch.zeros(1, 6, 8),
+        "context": torch.zeros(1, 1, 8),
+        "context_mask": torch.ones(1, count, 1, dtype=torch.bool),
+        "meta": {"grid_size": (5, height, width), "tokens_per_frame": height * width,
+                 "batch_size": 1},
+    }
+
+
+def joint_mask(count, action_tokens=2):
+    mask = torch.ones(count + action_tokens, count + action_tokens, dtype=torch.bool)
+    mask[:count, count:] = False
+    return mask
+
+
+def run_prefill(model, pre, mask, request=None):
+    if request is not None:
+        pre, video_mask, action_mask = request.prepare(pre, mask, heads=2)
+    else:
+        video_mask, action_mask = mask[:pre["tokens"].shape[1], :pre["tokens"].shape[1]], mask
+    cache = model.prefill_video_cache(
+        video_tokens=pre["tokens"], video_freqs=pre["freqs"],
+        video_t_mod=pre["t_mod"], video_context_payload=None,
+        video_attention_mask=video_mask, ikv_context=request)
+    return cache, video_mask, action_mask
+
+
+class VPP2IKVTests(unittest.TestCase):
+    def setUp(self):
+        torch.manual_seed(15)
+        self.model = MoT({"video": TinyExpert(), "action": TinyExpert()},
+                         mot_checkpoint_mixed_attn=False).eval()
+        self.rgb = {camera: np.zeros((8, 8, 3), dtype=np.uint8) for camera in range(3)}
+
+    def runtime(self, mode, env_id=0):
+        return VPP2IKVRuntime(mode=mode, scorer=FakeScorer(), expected_layers=2, env_id=env_id)
+
+    def test_rope_relocation_preserves_raw_keys(self):
+        pre = make_pre()
+        raw = torch.randn(1, 6, 8)
+        first = apply_rotary(raw, pre["freqs"][:6], 2)
+        restored = apply_rotary(first, pre["freqs"][:6], 2, inverse=True)
+        relocated = apply_rotary(restored, pre["freqs"][12:18], 2)
+        torch.testing.assert_close(relocated,
+                                   apply_rotary(raw, pre["freqs"][12:18], 2),
+                                   atol=5e-7, rtol=5e-7)
+
+    def test_tshape_regions_include_boundary_cameras_with_unit_mass(self):
+        for row in range(15):
+            for column in range(26):
+                regions = tshape_regions(["a", "b", "c", "d"], row, column, 15, 26)
+                self.assertAlmostEqual(sum(region.weight for region in regions), 1.0)
+                self.assertTrue(all(0 <= x <= 1 for region in regions for x in region.box))
+        mixed = tshape_regions(["a"], 7, 18, 15, 26)
+        self.assertEqual({region.sensor for region in mixed}, {0, 1, 2})
+
+    def test_window_warmup_duplicate_rgb_groups_have_distinct_native_slots(self):
+        runtime = self.runtime("window_refresh")
+        runtime.observe(0, self.rgb)
+        pre = make_pre()
+        mask = joint_mask(30)
+        native, _, _ = run_prefill(self.model, pre, mask)
+        with runtime.request(task="move", step=0, selected_steps=[0]*9) as request:
+            selected, _, action_mask = run_prefill(self.model, pre, mask, request)
+            self.assertEqual(len(set(request.tx.selected_ids)), 18)
+        self.assertEqual(len(runtime.bank.candidate_ids), 18)
+        for baseline_layer, selected_layer in zip(native, selected):
+            self.assertTrue(torch.equal(baseline_layer["k"], selected_layer["k"]))
+            self.assertTrue(torch.equal(baseline_layer["v"], selected_layer["v"]))
+        torch.testing.assert_close(mask, action_mask)
+
+    def test_incremental_reuses_archived_kv_and_keeps_native_future_capacity(self):
+        runtime = self.runtime("incremental_reuse")
+        first_raw = None
+        for turn, step in enumerate((0, 25, 50, 75)):
+            runtime.observe(step, self.rgb)
+            pre = make_pre(seed=turn)
+            with runtime.request(task="move", step=step) as request:
+                cache, video_mask, action_mask = run_prefill(
+                    self.model, pre, joint_mask(30), request)
+                self.assertEqual(video_mask.shape, (18, 30))
+                self.assertEqual(cache[0]["k"].shape, (1, 30, 8))
+                self.assertEqual(int(request.tx.valid_mask.sum()), min(6*(turn+1), 18))
+                self.assertTrue(video_mask[:, 18:].all())
+                self.assertTrue(action_mask[30:, 18:30].all())
+                if turn == 0:
+                    first_raw = apply_rotary(cache[0]["k"][:, 12:18], pre["freqs"][12:18], 2,
+                                             inverse=True)
+                if turn == 3:
+                    self.assertTrue(all("/g75/" not in uid for uid in request.tx.selected_ids))
+                    retrieved = apply_rotary(cache[0]["k"][:, :6], pre["freqs"][:6], 2,
+                                             inverse=True)
+                    torch.testing.assert_close(first_raw, retrieved, atol=1e-6, rtol=1e-6)
+                    # Future positions remain the current call's unmodified KV,
+                    # rather than being drawn from old action-visible caches.
+                    native_current_only, _, _ = run_prefill(self.model, pre, joint_mask(30))
+                    torch.testing.assert_close(cache[0]["k"][:, 18:],
+                                               native_current_only[0]["k"][:, 18:])
+            self.assertEqual(runtime.last_diagnostics["query_tokens"], 18)
+            self.assertEqual(runtime.last_diagnostics["cache_tokens"], 30)
+        self.assertEqual(len(runtime.bank.candidate_ids), 24)
+        self.assertEqual(runtime.scorer.calls, 1)
+        # Frames not selected this time still have committed per-layer payloads.
+        self.assertTrue(any("/g75/" in uid for uid in runtime.bank.candidate_ids))
+
+    def test_incremental_warmup_right_aligns_current_phase_and_masks_empty_slots(self):
+        runtime = self.runtime("incremental_reuse")
+        first_raw = first_values = None
+        for turn, step in enumerate((0, 25)):
+            runtime.observe(step, self.rgb)
+            pre = make_pre(seed=turn+100)
+            native, _, _ = run_prefill(self.model, pre, joint_mask(30))
+            with runtime.request(task="move", step=step) as request:
+                cache, video_mask, action_mask = run_prefill(
+                    self.model, pre, joint_mask(30), request)
+                empty = 12 - turn*6
+                self.assertEqual(request.padding_left, empty)
+                self.assertFalse(video_mask[:, :empty].any())
+                self.assertFalse(action_mask[:, :empty].any())
+                self.assertTrue(video_mask[:, empty:30].all())
+                self.assertTrue((cache[0]["k"][:, :empty] == 0).all())
+                self.assertTrue((cache[0]["v"][:, :empty] == 0).all())
+                # Current Q and current K retain the same native frame-2 phase.
+                torch.testing.assert_close(cache[0]["k"][:, 12:18], native[0]["k"][:, 12:18])
+                torch.testing.assert_close(cache[0]["v"][:, 12:18], native[0]["v"][:, 12:18])
+                torch.testing.assert_close(cache[0]["k"][:, 18:], native[0]["k"][:, 18:])
+                torch.testing.assert_close(cache[0]["v"][:, 18:], native[0]["v"][:, 18:])
+                if turn == 0:
+                    first_raw = apply_rotary(cache[0]["k"][:, 12:18], pre["freqs"][12:18],
+                                             2, inverse=True)
+                    first_values = cache[0]["v"][:, 12:18].clone()
+                else:
+                    torch.testing.assert_close(cache[0]["k"][:, 6:12],
+                        apply_rotary(first_raw, pre["freqs"][6:12], 2), atol=1e-6, rtol=1e-6)
+                    torch.testing.assert_close(cache[0]["v"][:, 6:12], first_values)
+
+    def test_failed_prefill_aborts_and_reset_isolates_environments(self):
+        first, second = self.runtime("incremental_reuse", 0), self.runtime("incremental_reuse", 1)
+        for runtime in (first, second):
+            runtime.observe(0, self.rgb)
+            with runtime.request(task="move", step=0) as request:
+                run_prefill(self.model, make_pre(), joint_mask(30), request)
+        existing_ids = first.bank.candidate_ids
+        first.observe(25, self.rgb)
+        with self.assertRaisesRegex(RuntimeError, "injected failure"):
+            with first.request(task="move", step=25) as request:
+                prepared, _, _ = request.prepare(make_pre(1), joint_mask(30), heads=2)
+                keys = torch.zeros_like(prepared["tokens"])
+                request.layer(0, keys, keys, raw_keys=keys)
+                raise RuntimeError("injected failure")
+        self.assertEqual(first.bank.candidate_ids, existing_ids)
+        first.reset()
+        self.assertEqual(first.bank.candidate_ids, ())
