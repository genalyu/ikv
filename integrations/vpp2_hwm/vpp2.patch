+class CountingVAE(nn.Module):
+    temporal_downsample_factor = 4
+
+    def __init__(self):
+        super().__init__()
+        self.frames_seen = []
+
+    def encode(self, videos, device, **kwargs):
+        encoded = []
+        for video in videos:
+            self.frames_seen.append(video.shape[1])
+            selected = video[:, ::4].mean(dim=0, keepdim=True)
+            pooled = torch.nn.functional.adaptive_avg_pool2d(
+                selected.permute(1, 0, 2, 3),
+                (video.shape[-2] // 8, video.shape[-1] // 8))
+            encoded.append(pooled.permute(1, 0, 2, 3).repeat(16, 1, 1, 1).to(device))
+        return encoded
+
+
+class CountingCLIP(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.calls = 0
+
+    def forward(self, videos):
+        self.calls += 1
+        return torch.stack([torch.ones(257, 1280, device=video.device,
+                                       dtype=video.dtype) * video.mean()
+                            for video in videos])
+
+
+def tiny_policy_model():
+    from vpp2.models.wan21_14b.vpp2 import VPP2
+    from vpp2.models.wan21_14b.wan_video_dit import WanVideoDiT
+    from vpp2.models.wan21_14b.action_dit import ActionDiT
+
+    torch.manual_seed(13)
+    video = WanVideoDiT(hidden_dim=24, num_heads=2, attn_head_dim=12,
+                        ffn_dim=48, freq_dim=8, text_dim=8, num_layers=2,
+                        video_attention_mask_mode="bidirectional")
+    action = ActionDiT(hidden_dim=24, action_dim=16, num_heads=2, attn_head_dim=12,
+                       ffn_dim=48, freq_dim=8, text_dim=8, num_layers=2, eps=1e-6)
+    mot = MoT({"video": video, "action": action}, mot_checkpoint_mixed_attn=False)
+    return VPP2(video, action, mot, CountingVAE(), clip_encoder=CountingCLIP(),
+                text_dim=8, proprio_dim=16, action_visible_video_frames=5).eval()
+
