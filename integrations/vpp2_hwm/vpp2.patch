+class FullInferenceTests(unittest.TestCase):
+    def setUp(self):
+        self.rgb = {sensor: np.zeros((8, 8, 3), dtype=np.uint8) for sensor in range(3)}
+        self.image = torch.zeros(1, 3, 32, 48)
+
+    def kwargs(self):
+        return dict(prompt=None, input_image=self.image, action_horizon=4,
+                    context=torch.zeros(1, 2, 8), context_mask=torch.ones(1, 2, dtype=torch.bool),
+                    proprio=torch.zeros(1, 16), seed=12, video_seed=42,
+                    num_video_frames=17, num_inference_steps=10)
+
+    def test_real_infer_action_window_parity_and_incremental_encoder_counts(self):
+        model = tiny_policy_model()
+        kwargs = self.kwargs()
+        condition = self.image.unsqueeze(2).repeat(1, 1, 9, 1, 1)
+        baseline = model.infer_action(**kwargs, condition_video=condition)["action"]
+        runtime = VPP2IKVRuntime(mode="window_refresh", scorer=FakeScorer(), expected_layers=2)
+        runtime.observe(0, self.rgb)
+        with runtime.request(task="move", step=0, selected_steps=[0]*9,
+                             anchor_image=self.image) as request:
+            window = model.infer_action(**kwargs, condition_video=condition,
+                                        ikv_context=request)["action"]
+        self.assertTrue(torch.equal(baseline, window))
+        self.assertEqual(model.vae.frames_seen, [9, 9])
+
+        incremental = VPP2IKVRuntime(mode="incremental_reuse", scorer=FakeScorer(), expected_layers=2)
+        model.vae.frames_seen.clear()
+        model.clip_encoder.calls = 0
+        action_calls = []
+        original = model._predict_action_noise_with_cache
+        def checked_action(**call):
+            action_calls.append(call["video_seq_len"])
+            self.assertEqual(call["video_kv_cache"][0]["k"].shape[1], 30)
+            return original(**call)
+        model._predict_action_noise_with_cache = checked_action
+        for step in (0, 25):
+            incremental.observe(step, self.rgb)
+            with incremental.request(task="move", step=step, anchor_image=self.image) as request:
+                result = model.infer_action(**kwargs, ikv_context=request)
+            self.assertEqual(result["action"].shape, (4, 16))
+            self.assertTrue(torch.isfinite(result["action"]).all())
+        self.assertEqual(model.vae.frames_seen, [1, 1])
+        self.assertEqual(model.clip_encoder.calls, 1)
+        self.assertEqual(action_calls, [30]*20)
+        self.assertEqual(incremental.last_diagnostics["query_tokens"], 18)
+
